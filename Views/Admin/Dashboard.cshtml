@model BusBookingSystem.Models.Booking
@{
    ViewData["Title"] = "Booking Detail";
}

<div class="container py-5">
    <div class="card shadow-sm border-0 p-4">
        <h3 class="fw-bold mb-3">Booking @Model.BookingCode</h3>
        <div class="row g-3">
            <div class="col-md-6">
                <p><strong>Passenger:</strong> @Model.CustomerName</p>
                <p><strong>Phone:</strong> @Model.Phone</p>
                <p><strong>Email:</strong> @Model.Email</p>
            </div>
            <div class="col-md-6">
                <p><strong>Route:</strong> @Model.Trip.Route.FromCity → @Model.Trip.Route.ToCity</p>
                <p><strong>Departure:</strong> @Model.Trip.DepartureDate.ToString("dd/MM/yyyy") • @Model.Trip.DepartureTime</p>
                <p><strong>Seat:</strong> @Model.SeatCode</p>
                <p><strong>Status:</strong> @Model.Status</p>
                <p><strong>Amount:</strong> @Model.Amount.ToString("N0")₫</p>
            </div>
        </div>
    </div>
</div>
