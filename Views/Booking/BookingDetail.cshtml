@model IEnumerable<BusBookingSystem.Models.Booking>
@{
    ViewData["Title"] = "My Bookings";
}

<div class="container py-5">
    <h2 class="fw-bold mb-4">My bookings</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">You have no bookings yet.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var booking in Model)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold">@booking.Trip.Route.FromCity → @booking.Trip.Route.ToCity</div>
                            <small class="text-muted">@booking.Trip.DepartureDate.ToString("dd/MM/yyyy") • @booking.Trip.DepartureTime</small>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold text-danger">@booking.SeatCode</div>
                            <div class="small text-muted">@booking.Status</div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="Booking" asp-action="BookingDetail" asp-route-id="@booking.Id" class="btn btn-outline-primary btn-sm">Details</a>
                    </div>
                </div>
            }
        </div>
    }
</div>
